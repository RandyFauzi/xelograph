# Copy to .env, then run npm run build and npm start.
PORT=3001
API_PORT=3002
HOST=127.0.0.1
# Optional explicit frontend origins when using HTTPS hosting (comma-separated).
# PUBLIC_ORIGIN=https://reuni.example.com
DATABASE_PATH=./data/xelograph.sqlite
# Generate a long random secret before enabling the admin dashboard.
ADMIN_TOKEN=
# Local development only. Enables the publicly labelled demo invitation XEL-DEMO.
DEMO_MODE=true
